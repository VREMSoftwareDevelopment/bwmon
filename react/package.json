{
    "name": "bwmon",
    "description": "Bandwidth Monitor",
    "version": "3.1.6",
    "homepage": "/bwmon/",
    "private": true,
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "serve": "vite preview",
        "test": "vitest --maxWorkers=50%",
        "test:once": "vitest run --maxWorkers=50%",
        "test:coverage": "vitest run --coverage --maxWorkers=50%",
        "test:CI": "vitest run --coverage --no-file-parallelism",
        "test:e2e": "npx playwright test",
        "test:mutation": "npx stryker run",
        "pretty": "prettier --write \"{src,e2e}/**/*.{ts,tsx,json,mjs}\" playwright.config.ts",
        "audit": "better-npm-audit audit -p -l high",
        "lint": "eslint \"{src,e2e}/**/*.{ts,tsx}\" playwright.config.ts",
        "typecheck": "tsc --noEmit",
        "scan": "node scan-suspicious.js",
        "outdated": "npm outdated --color=always | grep -viE \"beta|alpha\"",
        "duplication": "jscpd src",
        "clean": "npm cache clean --force",
        "analyze": "vite build",
        "suspicious": "node scan-suspicious.js"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "apexcharts": "^7.5.1",
        "luxon": "^3.7.2",
        "react": "^19.3.0",
        "react-apexcharts": "^2.1.1",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@emotion/babel-plugin": "^11.13.5",
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/luxon": "^3.7.5",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/eslint-plugin": "^1.6.27",
        "better-npm-audit": "^3.11.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-security": "^4.0.1",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "jscpd": "^5.3.2",
        "prettier": "^3.9.9",
        "rollup-plugin-visualizer": "^7.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "qs": "^6.16.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "prettier": {
        "trailingComma": "es5",
        "printWidth": 132,
        "tabWidth": 4,
        "singleQuote": true,
        "endOfLine": "auto"
    }
}
